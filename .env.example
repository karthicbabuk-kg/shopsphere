# Copy to .env and change values. Never commit .env.
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=shopsphere
POSTGRES_PORT=5433

DATABASE_URL=postgresql://shopsphere:change_me_locally@localhost:5433/shopsphere
TEST_DATABASE_URL=postgresql://shopsphere:change_me_locally@localhost:5433/shopsphere_test

# API
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string

# Cloudinary (Phase 5)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed (demo only)
SEED_ADMIN_EMAIL=admin@shopsphere.demo
SEED_ADMIN_PASSWORD=replace_with_demo_password  # at least 8 chars, no # character
