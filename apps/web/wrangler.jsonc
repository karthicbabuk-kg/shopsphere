{
  // Cloudflare Workers project for the ShopSphere website (static site + /api proxy).
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "shopsphere",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (React Router routes) get index.html so deep links and reloads work.
    "not_found_handling": "single-page-application",
    // Only API calls run Worker code; the site's files are served without invoking it.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public address of the Render API (no trailing slash, no path). Not a secret.
    "API_ORIGIN": "https://shopsphere-api-cihi.onrender.com"
  }
}
