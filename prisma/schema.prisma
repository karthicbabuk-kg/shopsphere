// ShopSphere schema. Money = integer paise. See docs/DATABASE.md.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────
enum Role {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum StockMovementType {
  OPENING
  INWARD
  OUTWARD
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN_RESTOCK
  RECONCILIATION
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum SellerOrderStatus {
  PLACED
  ACCEPTED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  UPI
  CARD
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum CouponType {
  PERCENT
  FLAT
}

enum SettlementStatus {
  PENDING
  PAID
}

enum AdjustmentStatus {
  OPEN
  APPLIED
  DISMISSED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}

// ───────── Auth ─────────
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  role         Role
  name         String
  phone        String?
  status       UserStatus @default(ACTIVE)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  sessions      UserSession[]
  buyerProfile  BuyerProfile?
  seller        Seller?
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  auditLogs     AuditLog[]
  couponUsage   CouponUsage[]

  @@index([role])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

// ───────── Buyer ─────────
model BuyerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlist Wishlist?

  @@map("buyer_profiles")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String   @default("Home")
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  buyerId   String   @unique @db.Uuid
  createdAt DateTime @default(now())

  buyer BuyerProfile   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ───────── Seller ─────────
model Seller {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @unique @db.Uuid
  status          SellerStatus @default(PENDING)
  businessName    String
  gstin           String?
  pan             String?
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       SellerStore?
  documents   SellerDocument[]
  products    Product[]
  warehouses  Warehouse[]
  orders      SellerOrder[]
  settlements SellerSettlement[]
  movements   StockMovement[]

  @@index([status])
  @@map("sellers")
}

model SellerStore {
  id           String   @id @default(uuid()) @db.Uuid
  sellerId     String   @unique @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  logoUrl      String?
  bannerUrl    String?
  contactEmail String?
  contactPhone String?
  city         String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_stores")
}

model SellerDocument {
  id        String         @id @default(uuid()) @db.Uuid
  sellerId  String         @db.Uuid
  type      String
  url       String
  publicId  String?
  status    DocumentStatus @default(PENDING)
  createdAt DateTime       @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_documents")
}

// ───────── Catalogue ─────────
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  slug      String   @unique
  imageUrl  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@map("brands")
}

model Product {
  id          String         @id @default(uuid()) @db.Uuid
  sellerId    String         @db.Uuid
  categoryId  String         @db.Uuid
  brandId     String?        @db.Uuid
  name        String
  slug        String         @unique
  description String
  mrpPaise    Int
  pricePaise  Int
  status      ProductStatus  @default(DRAFT)
  approval    ApprovalStatus @default(PENDING)
  rejectionReason String?
  ratingAvg   Decimal        @default(0) @db.Decimal(3, 2)
  ratingCount Int            @default(0)
  soldCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  seller     Seller             @relation(fields: [sellerId], references: [id])
  category   Category           @relation(fields: [categoryId], references: [id])
  brand      Brand?             @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  attributes ProductAttribute[]
  reviews    Review[]
  wishlisted WishlistItem[]

  @@index([approval, status, categoryId])
  @@index([sellerId])
  @@index([pricePaise])
  @@index([createdAt(sort: Desc)])
  @@index([soldCount(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url       String
  publicId  String?
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @db.Uuid
  sku          String    @unique
  label        String    @default("Default")
  optionValues Json      @default("{}")
  pricePaise   Int?
  mrpPaise     Int?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductAttribute {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  key       String
  value     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

// ───────── Inventory ─────────
model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  sellerId  String   @db.Uuid
  name      String
  location  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  seller      Seller      @relation(fields: [sellerId], references: [id])
  inventories Inventory[]

  @@index([sellerId])
  @@map("warehouses")
}

// CHECK (available >= 0 AND reserved >= 0) is added in the migration SQL.
model Inventory {
  id           String   @id @default(uuid()) @db.Uuid
  variantId    String   @unique @db.Uuid
  warehouseId  String   @db.Uuid
  available    Int      @default(0)
  reserved     Int      @default(0)
  sold         Int      @default(0)
  reorderLevel Int      @default(5)
  updatedAt    DateTime @updatedAt

  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  movements   StockMovement[]
  adjustments StockAdjustment[]

  @@index([warehouseId])
  @@index([available])
  @@map("inventories")
}

// Append-only: a trigger (migration SQL) rejects UPDATE and DELETE.
model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  inventoryId String            @db.Uuid
  sellerId    String            @db.Uuid
  type        StockMovementType
  previousQty Int
  changeQty   Int
  newQty      Int
  reason      String?
  referenceNo String?
  createdById String?           @db.Uuid
  createdAt   DateTime          @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  seller    Seller    @relation(fields: [sellerId], references: [id])

  @@index([inventoryId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt])
  @@map("stock_movements")
}

model StockAdjustment {
  id          String           @id @default(uuid()) @db.Uuid
  inventoryId String           @db.Uuid
  expectedQty Int
  countedQty  Int
  difference  Int
  reason      String?
  status      AdjustmentStatus @default(OPEN)
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId])
  @@map("stock_adjustments")
}

// ───────── Shopping ─────────
model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ───────── Orders ─────────
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNo         String      @unique
  buyerId         String      @db.Uuid
  addressId       String?     @db.Uuid
  addressSnapshot Json
  subtotalPaise   Int
  discountPaise   Int         @default(0)
  deliveryPaise   Int         @default(0)
  taxPaise        Int         @default(0)
  totalPaise      Int
  status          OrderStatus @default(PLACED)
  idempotencyKey  String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer       User          @relation(fields: [buyerId], references: [id])
  address     Address?      @relation(fields: [addressId], references: [id])
  sellerOrders SellerOrder[]
  payments    Payment[]
  couponUsage CouponUsage?

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model SellerOrder {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @db.Uuid
  sellerId        String            @db.Uuid
  subtotalPaise   Int
  taxPaise        Int               @default(0)
  deliveryPaise   Int               @default(0)
  totalPaise      Int
  status          SellerOrderStatus @default(PLACED)
  carrier         String?
  trackingNo      String?
  cancelReason    String?
  returnStatus    ReturnStatus?
  returnReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order      Order                @relation(fields: [orderId], references: [id])
  seller     Seller               @relation(fields: [sellerId], references: [id])
  items      OrderItem[]
  history    OrderStatusHistory[]
  commission Commission?
  refunds    Refund[]

  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("seller_orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  sellerOrderId       String   @db.Uuid
  variantId           String?  @db.Uuid
  productNameSnapshot String
  skuSnapshot         String
  imageSnapshot       String?
  unitPricePaise      Int
  quantity            Int
  lineTotalPaise      Int
  createdAt           DateTime @default(now())

  sellerOrder SellerOrder     @relation(fields: [sellerOrderId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([sellerOrderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  sellerOrderId String   @db.Uuid
  fromStatus    String?
  toStatus      String
  actorId       String?  @db.Uuid
  note          String?
  createdAt     DateTime @default(now())

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])

  @@index([sellerOrderId, createdAt])
  @@map("order_status_history")
}

// ───────── Finance ─────────
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amountPaise   Int
  demoReference String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id            String       @id @default(uuid()) @db.Uuid
  paymentId     String       @db.Uuid
  sellerOrderId String?      @db.Uuid
  amountPaise   Int
  reason        String?
  status        RefundStatus @default(REQUESTED)
  createdAt     DateTime     @default(now())

  payment     Payment      @relation(fields: [paymentId], references: [id])
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

model Commission {
  id              String   @id @default(uuid()) @db.Uuid
  sellerOrderId   String   @unique @db.Uuid
  rateBp          Int
  amountPaise     Int
  netSellerPaise  Int
  settlementId    String?  @db.Uuid
  createdAt       DateTime @default(now())

  sellerOrder SellerOrder         @relation(fields: [sellerOrderId], references: [id])
  settlement  SellerSettlement?   @relation(fields: [settlementId], references: [id])

  @@map("commissions")
}

model SellerSettlement {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @db.Uuid
  periodStart     DateTime
  periodEnd       DateTime
  grossPaise      Int
  commissionPaise Int
  netPaise        Int
  status          SettlementStatus @default(PENDING)
  createdAt       DateTime         @default(now())

  seller      Seller       @relation(fields: [sellerId], references: [id])
  commissions Commission[]

  @@index([sellerId])
  @@map("seller_settlements")
}

// ───────── Marketing / CX / Admin ─────────
model Coupon {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  description      String?
  type             CouponType
  value            Int
  minOrderPaise    Int        @default(0)
  maxDiscountPaise Int?
  usageLimit       Int?
  usedCount        Int        @default(0)
  validFrom        DateTime   @default(now())
  validTo          DateTime?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())

  usage CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id          String   @id @default(uuid()) @db.Uuid
  couponId    String   @db.Uuid
  userId      String   @db.Uuid
  orderId     String   @unique @db.Uuid
  discountPaise Int
  createdAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usage")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}
