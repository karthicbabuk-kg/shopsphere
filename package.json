{
  "name": "shopsphere",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @shopsphere/api --filter @shopsphere/web dev",
    "dev:api": "pnpm --filter @shopsphere/api dev",
    "dev:web": "pnpm --filter @shopsphere/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @shopsphere/api prisma:migrate",
    "db:seed": "pnpm --filter @shopsphere/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
